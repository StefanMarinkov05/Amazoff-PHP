# Secrets — never commit. A key that reaches git history can only be fixed by
# rotating the key; deleting the commit is not enough.
.env
.env.*
!.env.example
*.pem
auth.json

# Planning material — CLAUDE.md, ADRs, spec, open questions. On disk for
# reference, deliberately not versioned in this repo; online-store/ is the
# actual deliverable.
misc/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Personal Claude Code skill config — Windows directory junctions into a
# per-machine archive, not project source. Wouldn't survive a clone anyway.
.claude/

# Laravel's own .gitignore is added when the app is scaffolded and merges
# with this file.

# Laravel Boost — generated, not source. `online-store/.ai/guidelines/` is the
# hand-written part and IS committed; everything below is rebuilt from it by
# `php artisan boost:install`, so committing it would only produce churn on
# every regeneration. Same split this repo already applies to the race worker
# and to Blueprint's output: the source is versioned, the artifact is not.
online-store/CLAUDE.md
online-store/boost.json
online-store/.claude/skills/
