APP_NAME="Amazoff"
# local | demo | production. `demo` is what the hosted beta box runs, and the
# choice is load-bearing rather than cosmetic: app()->isProduction() compares
# this to the literal string "production", and three seeders refuse to run
# when it matches — UserSeeder (every account here has a known password),
# SeedDemo, and every individual Demo* seeder. So APP_ENV=production on a
# demo box yields an empty shop with nobody able to log in. ADR-0023.
APP_ENV=local
APP_KEY=
# MUST be false on any hosted box, independently of APP_ENV above. Debug true
# renders a stack trace — file paths, env values, SQL — to whoever triggers
# the error. phase-3-error-leak-sweep.md is the record of what that leaks.
APP_DEBUG=true
# Read by config/filesystems.php to build the `public` disk's URL, so every
# product and article image resolves against it. A wrong value here is not a
# broken link in one place — it is a catalogue of broken images that looks
# like the seed failed. Must be the full external origin, scheme included.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose.yml's db service. Container hostname, not localhost —
# "127.0.0.1" from inside the app container is the container itself, not mysql.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=amazoff
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# false locally: a Secure cookie is not sent over http://localhost, so marking
# it here would break the dev session outright.
#
# MUST be true in production. Without it the session cookie can travel over
# plain HTTP and be captured on the network. config/session.php reads this
# key and defaults to null when it is unset, which is the same as false —
# so an unset variable is a silently insecure production deploy rather than
# an error anyone sees. SEC-013.
SESSION_SECURE_COOKIE=false

# --- Hosted deploy (ADR-0023) ----------------------------------------------
# Nothing below is needed for local Docker. All of it matters on a hosted box,
# and the notes are the part worth reading — each one records a failure that
# is quiet rather than loud.
#
# TRUSTED PROXIES are NOT an env var here: bootstrap/app.php calls
# trustProxies(at: '*') unconditionally, because Railway's edge address is
# neither stable nor documented. Without that call a TLS-terminating host
# makes isSecure() false for every request, url() emits http:// links, and
# the public disk's image URLs come out with the wrong scheme. If this app
# ever moves to a host with a fixed, known proxy address, name it there
# rather than adding a variable here.
#
# On Railway specifically:
#   APP_ENV=demo              (NOT production — see the note at the top)
#   APP_DEBUG=false
#   APP_URL=https://<your-service>.up.railway.app
#   SESSION_SECURE_COOKIE=true
#   DB_* from the MySQL service's own variables (DB_HOST is the private
#     hostname Railway injects, never 127.0.0.1)
#   PORT is injected by the platform; the image substitutes it into nginx's
#     config at start. Do not set it by hand.
#
# MAIL_* must point at a real relay, not Mailpit — `mailpit` is a
# docker-compose hostname that does not resolve on a hosted box, and queued
# mail fails silently against it (the job retries, the customer gets
# nothing). For a demo with no real relay, MAIL_MAILER=log writes to the
# container's log instead of pretending to send.
#
# COUPON_EMAIL_PEPPER must be set and non-empty wherever coupons are used:
# RedeemCoupon hashes the email with it, so a blank pepper is not a weaker
# hash, it is a different one than the rows were written with.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit — docker-compose service, web UI at localhost:8025. Never a real
# SMTP relay locally.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@online-shop.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Couriers (ADR-0017 — CourierGateway, two implementations) -------------
# Econt has a public demo environment. Speedy has no public sandbox; its
# credentials stay blank until a real account is issued.
ECONT_API_URL=https://demo.econt.com/ee/services/
ECONT_USERNAME=
ECONT_PASSWORD=
SPEEDY_API_URL=
SPEEDY_USERNAME=
SPEEDY_PASSWORD=
# All optional — config/couriers.php's own defaults match these.
# COURIER_DEFAULT=econt
# COURIER_TIMEOUT=10
# COURIER_OFFICES_CACHE_TTL=86400
# COURIER_QUOTE_CACHE_TTL=300
# COURIER_DEFAULT_PARCEL_WEIGHT_GRAMS=500

# --- Coupons (explanation/gdpr.md — email hashing) --------------------------
# Never the plaintext email itself; only its SHA-256 alongside this pepper is
# stored, so the pepper must never live in the database.
COUPON_EMAIL_PEPPER=

# --- Filament -----------------------------------------------------------
FILAMENT_DOMAIN=
FILAMENT_PATH=admin

# --- demo:fetch-images (docs/how-to/seed-the-database.md, "Product images") -
# Free key from pexels.com/api. Only needed if re-running the image fetch;
# the committed demo images already cover every product_images row.
PEXELS_API_KEY=

# --- database/seeders/Stress/ (docs/how-to/seed-the-database.md) ------------
# Override the default order/product counts for the two opt-in stress
# seeders. Leave blank to use each seeder's own default.
STRESS_SEED_COUNT=
CATALOGUE_STRESS_COUNT=


# --- Stripe (§37 #9-#11) ---------------------------------------------------
# Test keys from dashboard.stripe.com/test/apikeys. STRIPE_WEBHOOK_SECRET is
# printed by `stripe listen --forward-to localhost:8080/stripe/webhook` and is
# NOT the same value as STRIPE_SECRET. The webhook route is CSRF-excluded, so
# this signing secret is the only thing proving a request came from Stripe —
# without it the endpoint accepts anything.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Only during a secret roll: set to the OUTGOING secret so events Stripe
# signs with the new one are not rejected while the old is still valid
# (up to 24h). Remove it once the roll completes.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_CURRENCY=eur
STRIPE_WEBHOOK_TOLERANCE=300
