APP_NAME="Amazoff"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose.yml's db service. Container hostname, not localhost —
# "127.0.0.1" from inside the app container is the container itself, not mysql.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=online_shop
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit — docker-compose service, web UI at localhost:8025. Never a real
# SMTP relay locally.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@online-shop.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Stripe (ADR-0006 — hosted Checkout) -----------------------------------
# Test-mode keys from the team's shared Stripe dashboard. Never the live keys.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Couriers (ADR-0008 — CourierGateway, two implementations) -------------
# Econt has a public demo environment. Speedy sandbox access is the week-1
# spike in docs/open-questions.md — fill in once resolved.
ECONT_API_URL=https://demo.econt.com/ee/services/
ECONT_USERNAME=
ECONT_PASSWORD=

SPEEDY_API_URL=
SPEEDY_USERNAME=
SPEEDY_PASSWORD=

# --- Coupons (explanation/gdpr.md — email hashing) --------------------------
# Never the plaintext email itself; only its SHA-256 alongside this pepper is
# stored, so the pepper must never live in the database.
COUPON_EMAIL_PEPPER=

# --- Filament -----------------------------------------------------------
FILAMENT_DOMAIN=
FILAMENT_PATH=admin
